# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4001
HOST=0.0.0.0
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (in addition to defaults)
ALLOWED_ORIGINS=https://video.teckvora.com

# ─── Rate Limits ──────────────────────────────────────────────────────────────
# Max download/preview requests per minute per IP
DOWNLOAD_RATE_LIMIT=10

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_central
DB_USER=root
DB_PASS=
DB_POOL_SIZE=10

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
